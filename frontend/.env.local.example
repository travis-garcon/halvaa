NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Map style URL. By default the app uses a local proxy (/api/map-style)
# that rewrites OpenFreeMap tile URLs to same-origin routes for zero
# external requests from the browser. Set to a remote URL to bypass
# the proxy, or set to empty string to disable the map.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Set to true only in local/demo environments to show sample data when the API is empty.
NEXT_PUBLIC_DEMO_FALLBACK=false

# Optional local terrain PMTiles (Terrarium-encoded raster DEM) served by the
# Docker local-map container, for example:
# NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL=http://localhost:8081/terrain-dem.pmtiles
# Generate this file with: .\scripts\download-local-map.ps1 -IncludeTerrain

# Production: set NEXT_PUBLIC_API_URL to your API origin (e.g. https://api.halvaa.net/api/v1).
# Fonts (Google Sans + IRANYekanX) are self-hosted in public/fonts/ — no external CDN.
