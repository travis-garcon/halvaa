FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm install --no-audit --no-fund

FROM node:20-alpine AS builder
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_FALLBACK=false
ARG NEXT_PUBLIC_MAP_STYLE_URL
ARG NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL
ARG NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL
ARG NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_DEMO_FALLBACK=$NEXT_PUBLIC_DEMO_FALLBACK \
    NEXT_PUBLIC_MAP_STYLE_URL=$NEXT_PUBLIC_MAP_STYLE_URL \
    NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL=$NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL \
    NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL=$NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL \
    NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL=$NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL \
    NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_FALLBACK=false
ARG NEXT_PUBLIC_MAP_STYLE_URL
ARG NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL
ARG NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL
ARG NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL
ENV NODE_ENV=production \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_DEMO_FALLBACK=$NEXT_PUBLIC_DEMO_FALLBACK \
    NEXT_PUBLIC_MAP_STYLE_URL=$NEXT_PUBLIC_MAP_STYLE_URL \
    NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL=$NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL \
    NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL=$NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL \
    NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL=$NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/messages ./messages
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
