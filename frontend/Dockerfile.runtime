FROM node:20-alpine

ARG NEXT_PUBLIC_API_URL
ARG NEXT_INTERNAL_API_URL=http://backend:8000/api/v1
ARG NEXT_PUBLIC_DEMO_FALLBACK=false
ARG NEXT_PUBLIC_MAP_STYLE_URL
ARG NEXT_PUBLIC_LOCAL_MAP_ENABLED=false
ARG NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
ARG NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL
ARG NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL
ARG NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL

ENV NODE_ENV=production \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_INTERNAL_API_URL=$NEXT_INTERNAL_API_URL \
    NEXT_PUBLIC_DEMO_FALLBACK=$NEXT_PUBLIC_DEMO_FALLBACK \
    NEXT_PUBLIC_MAP_STYLE_URL=$NEXT_PUBLIC_MAP_STYLE_URL \
    NEXT_PUBLIC_LOCAL_MAP_ENABLED=$NEXT_PUBLIC_LOCAL_MAP_ENABLED \
    NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=$NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN \
    NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL=$NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL \
    NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL=$NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL \
    NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL=$NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /app

COPY .next/standalone ./
COPY public ./public
COPY messages ./messages
COPY .next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
