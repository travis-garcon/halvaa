--- /etc/nginx/sites-available/halvaa
+++ /etc/nginx/sites-available/halvaa
@@ -20,6 +20,9 @@
     # before they reached the API.
     client_max_body_size 110m;
 
+    # Halvaa-only maintenance response. Shared project routes do not use it.
+    include /etc/nginx/snippets/halvaa-maintenance-location.conf;
+
     # Isolated Zeman contract app; all routes remain under /zeman/.
     include /etc/nginx/snippets/zeman.conf;
 
