BACKEND_ENV_FILE=./backend/.env.production

POSTGRES_USER=halvaa
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=halvaa

DATABASE_URL=postgresql://halvaa:replace-with-a-strong-db-password@db:5432/halvaa
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_API_URL=https://api.halvaa.example.com/api/v1
NEXT_PUBLIC_DEMO_FALLBACK=false

# Public app ports exposed by docker compose.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional map overrides.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_LOCAL_MAP_PM_TILES_URL=
NEXT_PUBLIC_LOCAL_MAP_ASSETS_URL=
NEXT_PUBLIC_LOCAL_MAP_TERRAIN_PM_TILES_URL=
