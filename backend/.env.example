DATABASE_URL=postgresql://halvaa:halvaa@localhost:5432/halvaa
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
ENFORCE_MEMORIAL_SLOT_LIMIT=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
PUBLIC_API_BASE_URL=http://localhost:8000

# OTP delivery
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER=
SMTP_HOST=smtp
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@halvaa.app
SMTP_FROM_NAME=Halvaa
SMTP_USE_TLS=false
SMTP_HELO_DOMAIN=halvaa.app
SMTP_DIRECT_DELIVERY=false

# Google OAuth placeholder. Fill these when the Google app credentials are ready.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_POST_LOGIN_URL=http://localhost:3000/en/profile

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/en/store?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/en/store?payment=cancel
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=http://localhost:8000/api/v1/store/zarinpal/verify
ZARINPAL_SANDBOX=true
ZARINPAL_DESCRIPTION=Halvaa package purchase
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
PAYMENT_FRONTEND_BASE_URL=http://localhost:3000
PAYMENT_TEST_MODE=true

# Translation. Keep disabled until a LibreTranslate-compatible service is configured.
TRANSLATION_PROVIDER=disabled
LIBRETRANSLATE_URL=https://libretranslate.de
LIBRETRANSLATE_API_KEY=

# Dev seed (after migrations): python -m scripts.seed_dev_data
# Dev admin: dev@example.com / devpassword123

# Production: set ENVIRONMENT=production, a strong SECRET_KEY, and CORS_ORIGINS to your frontend URL(s).
