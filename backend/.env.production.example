DATABASE_URL=postgresql://halvaa:change-this@db:5432/halvaa
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=production
CORS_ORIGINS=["https://halvaa.example.com"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/app/uploads
SESSION_SECRET=replace-with-a-second-long-random-secret
SESSION_DURATION=86400
ZITADEL_DOMAIN=https://zitadel.example.com
ZITADEL_CLIENT_ID=replace-with-your-zitadel-client-id
ZITADEL_CLIENT_SECRET=replace-with-your-zitadel-client-secret
ZITADEL_CALLBACK_URL=https://api.halvaa.example.com/api/v1/auth/callback
ZITADEL_POST_LOGIN_URL=https://halvaa.example.com/
ZITADEL_POST_LOGOUT_URL=https://halvaa.example.com/
